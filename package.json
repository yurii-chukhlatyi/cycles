{
  "name": "portfolio-cycles",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint src tests --max-warnings=0",
    "test": "vitest run",
    "tauri": "tauri",
    "format": "prettier --write src tests/ui",
    "build:e2e": "tsc -b && vite build --mode e2e",
    "test:desktop": "node scripts/test-desktop.mjs",
    "test:google-live": "node scripts/test-google-live.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "lucide-react": "^0.468",
    "react": "^19",
    "react-dom": "^19",
    "recharts": "^3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "@wdio/cli": "^9.31.2",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.31.2",
    "@wdio/mocha-framework": "^9.31.2",
    "@wdio/spec-reporter": "^9.31.2",
    "@wdio/tauri-plugin": "1.5.1",
    "@wdio/tauri-service": "1.5.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "expect-webdriverio": "^6.1.0",
    "globals": "^16",
    "jsdom": "^26",
    "prettier": "^3.9.10",
    "typescript": "^5.8",
    "typescript-eslint": "^8",
    "vite": "^6",
    "vitest": "^3",
    "webdriverio": "^9.31.9"
  }
}
